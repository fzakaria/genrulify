#!@SPLICE_BASH@/bin/bash
# Runs one step of a recorded build the way the recording saw it run, and
# checks that it left what the recording saw it leave.
#
# A generated genrule calls this script with the step's real command line.
# The script exists because a recorded command only makes sense in the
# place it ran: it names /build and the output path absolutely, expects its
# recorded environment and descriptors, and must not see files the rule
# did not declare. So the script stages the declared inputs under a
# private root, mounts that root and the store closure at their recorded
# paths with bubblewrap, starts each process, and compares every declared
# result with the recorded kind, mode and SHA-256 before handing it on.
#
# usage: sandbox.sh --name NAME --in DIR... --out DIR [--timeout SECONDS] [--trust]
#                   [--pipe ID:LAST_WRITER:READERS:BROKE]...
#                   (run OPTIONS --argc N -- PROGRAM ARG...)...
#        sandbox.sh --name NAME --in DIR... --out DIR pack GUEST_PATH [SHA256]
#
# Files are looked up by name under each --in directory:
#   actions/NAME.manifest   the entries to stage and the results to expect
#   closure.txt             store paths to mount read-only
#   env/N.env               an environment, NUL-separated NAME=VALUE
#   source.txt              for a project, the store path of its source
#                           tree, which is staged and not read from the host
#   outputs.txt             for a project, the store paths the build fills
#   RULE.ok                 the stamp of a rule this step takes entries from
#
# With --trust a result is whatever the processes left, provided it is
# there and is a file, a directory or a symlink as recorded. The commands
# of a project that read its sources run that way, so that an edited source
# builds. Such a step writes into its stamp the mode of each file and
# directory it left and the target of each symlink, and a step that is
# given one of those entries stages it as the stamp says. A trusted step
# that leaves an entry under an output path which the recorded build did
# not leave fails: no rule would pick the entry up.
#
# A manifest line is a tag and then a kind, a mode, an mtime, a path, the
# content, an artifact and an origin. The tag `in` is an entry to stage,
# `out` a result to expect, and `unused` a path the recorded command wrote
# that nothing reads. The origin of an `in` line is empty when the entry is
# staged as recorded, the name of the rule whose stamp describes it, or
# @checkout for a file of the project, which keeps the executable bit the
# project's file has.
#
# run options:
#   --cwd DIR        working directory inside the sandbox
#   --env N          which environment file to use
#   --argv0 TEXT     argv[0], when it differs from PROGRAM
#   --fd N=SPEC      descriptor N: null, err, pipe-r:ID, pipe-w:ID,
#                    data:FILE (bytes the builder had written into a pipe),
#                    store:PATH, file:r|w|a:GUEST_PATH, or
#                    file:r@OFFSET:GUEST_PATH for a file already read up to
#                    an offset
#   --after I,J      start only after processes I and J have exited
#   --status N       the exit status the recording saw
set -u

C=@SPLICE_COREUTILS@/bin
BWRAP=@SPLICE_BWRAP@/bin/bwrap
NIX_STORE=@SPLICE_NIX@/bin/nix-store

# The identity the Nix sandbox gives a builder, which the recording had.
BUILD_UID=1000
BUILD_GID=100
BUILD_HOST=localhost

# The phrases a failure is reported with. `genrulify learn` reads them back
# out of a build log.
NOT_REPRODUCED=" did not reproduce the recording:"

# The same for a rule of a project, which is not held to the recorded
# bytes: its results are missing or are another kind of thing.
NOT_LEFT=" did not leave what the recorded build left:"

# The field separator of a manifest line. A tab would do, except that the
# shell merges adjacent tabs and so loses an empty field.
FS=$'\x1f'

# The extension of the stamp a step writes once its results check out, the
# origin of a file that is the project's own, and the file that lists the
# output paths of a project's build.
STAMP=.ok
CHECKOUT=@checkout
OUTPUTS_FILE=outputs.txt

# Permission bits: the owner's right to execute, everyone's right to
# execute, and everyone's right to read. A read bit is two places above
# the execute bit of the same class.
OWNER_EXECUTE=$((8#100))
ALL_EXECUTE=$((8#111))
ALL_READ=$((8#444))
READ_TO_EXECUTE=2

fail() {
    echo "sandbox.sh: $*" >&2
    exit 2
}

# The script keeps pipe ends and fed files open on descriptors of its own
# until each process has the ones it needs. Those must not collide with a
# descriptor a process is to be given, such as the 63 of a process
# substitution, so they are numbered from above the highest one asked for.
FIRST_HELD_DESCRIPTOR=100
next_descriptor=$FIRST_HELD_DESCRIPTOR
previous=
for argument in "$@"; do
    number=${argument%%=*}
    if [ "$previous" = --fd ] && [[ $number =~ ^[0-9]+$ ]] && [ "$number" -ge "$next_descriptor" ]; then
        next_descriptor=$((number + 1))
    fi
    previous=$argument
done

# ---- arguments up to the first `run` or `pack` ------------------------------

name=
out=
timeout=
trust=
in_dirs=()
declare -A pipe_last_writer pipe_readers pipe_broke
while [ $# -gt 0 ]; do
    case $1 in
        --name) name=$2; shift 2 ;;
        --in) in_dirs+=("$2"); shift 2 ;;
        --out) out=$2; shift 2 ;;
        --timeout) timeout=$2; shift 2 ;;
        --trust) trust=1; shift ;;
        --pipe)
            IFS=: read -r id last readers broke <<< "$2"
            pipe_last_writer[$id]=$last
            pipe_readers[$id]=$readers
            pipe_broke[$id]=$broke
            shift 2
            ;;
        run | pack) break ;;
        *) fail "unknown option $1" ;;
    esac
done
[ -n "$name" ] && [ -n "$out" ] || fail "--name and --out are required"

# A process that waits for input the recording had and this run does not
# would wait forever. Run the whole step under a deadline.
if [ -n "$timeout" ] && [ -z "${GENRULIFY_DEADLINE:-}" ]; then
    saved=(--name "$name" --out "$out" ${trust:+--trust})
    for dir in "${in_dirs[@]}"; do saved+=(--in "$dir"); done
    for id in "${!pipe_last_writer[@]}"; do
        saved+=(--pipe "$id:${pipe_last_writer[$id]}:${pipe_readers[$id]}:${pipe_broke[$id]}")
    done
    GENRULIFY_DEADLINE=1 exec "$C/timeout" --kill-after=10 "$timeout" "$0" "${saved[@]}" "$@"
fi

# The first --in directory that holds a file.
find_input() {
    local dir
    for dir in "${in_dirs[@]}"; do
        if [ -e "$dir/$1" ]; then
            printf '%s' "$dir/$1"
            return 0
        fi
    done
    fail "no input named $1"
}

# The same for a file a workspace need not have. Fails quietly.
find_optional_input() {
    local dir
    for dir in "${in_dirs[@]}"; do
        if [ -e "$dir/$1" ]; then
            printf '%s' "$dir/$1"
            return 0
        fi
    done
    return 1
}

# Loads the stamp of the rule $1, once: what that rule saw each of its
# results to be. A rule held to the recording writes an empty stamp,
# because its results are the recorded ones.
declare -A stamp_loaded seen_mode seen_target
observe() {
    [ -z "${stamp_loaded[$1]:-}" ] || return 0
    stamp_loaded[$1]=1
    local stamp kind mode path target
    stamp=$(find_optional_input "$1$STAMP") || return 0
    while IFS=$FS read -r kind mode path target; do
        seen_mode[$1$FS$path]=$mode
        seen_target[$1$FS$path]=$target
    done < "$stamp"
}

# The recorded mode $1 with the executable bits of the project's file $2.
# Nix stores a file as executable or not, by the owner's bit, and a build
# that copies the file hands that on. Every class that may read the file
# may then run it.
checkout_mode() {
    local recorded=$((8#$1)) held
    held=$("$C/stat" -L -c %a "$2") || fail "cannot stat $2"
    if (((8#$held & OWNER_EXECUTE) != 0)); then
        printf '%o' $((recorded | ((recorded & ALL_READ) >> READ_TO_EXECUTE)))
    else
        printf '%o' $((recorded & ~ALL_EXECUTE))
    fi
}

scratch=$("$C/mktemp" -d) || fail "cannot create a scratch directory"
cleanup() {
    # Staged directories keep their recorded modes, which can deny the
    # owner the access removal needs.
    "$C/chmod" -R u+rwx "$scratch" 2> /dev/null
    "$C/rm" -rf "$scratch"
}
trap cleanup EXIT
root=$scratch/root
"$C/mkdir" -p "$root/build" "$root/nix/store" "$root/tmp" "$root/bin" "$root/etc"

# ---- stage the declared inputs ----------------------------------------------

manifest=$(find_input "actions/$name.manifest")
declare -A known        # guest paths the step was given or is expected to write
directories=()          # mode, mtime and path of every staged directory
results=()              # the manifest's `out` lines

while IFS=$FS read -r tag kind mode mtime path content artifact origin; do
    known[$path]=1
    if [ "$tag" = out ]; then
        results+=("$kind$FS$mode$FS$mtime$FS$path$FS$content$FS$artifact")
        continue
    fi
    if [ "$tag" = unused ]; then
        continue
    fi
    host=$root$path

    # An entry a trusted rule made is staged the way that rule left it.
    if [ -n "${origin:-}" ] && [ "$origin" != "$CHECKOUT" ]; then
        observe "$origin"
        if [ -n "${seen_mode[$origin$FS$path]:-}" ]; then
            mode=${seen_mode[$origin$FS$path]}
            if [ "$kind" = link ]; then
                content=${seen_target[$origin$FS$path]}
            fi
        fi
    fi
    case $kind in
        dir)
            "$C/mkdir" -p "$host"
            directories+=("$mode$FS$mtime$FS$path")
            ;;
        link)
            "$C/mkdir" -p "${host%/*}"
            "$C/ln" -s "$content" "$host"
            "$C/touch" -h -d "@$mtime" "$host"
            ;;
        file)
            "$C/mkdir" -p "${host%/*}"
            staged=$(find_input "$artifact")
            "$C/cp" "$staged" "$host" || fail "cannot stage $path"
            if [ "${origin:-}" = "$CHECKOUT" ]; then
                mode=$(checkout_mode "$mode" "$staged")
            fi
            "$C/chmod" "$mode" "$host"
            "$C/touch" -d "@$mtime" "$host"
            ;;
        *) fail "unknown entry kind $kind" ;;
    esac
done < "$manifest"

# A directory gets its recorded mode and mtime last: the mode can deny the
# writes that created its children, and those writes move its mtime.
if [ ${#directories[@]} -gt 0 ]; then
    while IFS=$FS read -r mode mtime path; do
        "$C/chmod" "$mode" "$root$path"
        "$C/touch" -d "@$mtime" "$root$path"
    done < <(printf '%s\n' "${directories[@]}" | "$C/sort" -t"$FS" -k3,3r)
fi

# ---- pack: serialize one output path as a NAR -------------------------------

if [ "${1:-}" = pack ]; then
    guest=$2
    expected=${3:-}
    archive=$out/$name.nar
    [ -e "$root$guest" ] || [ -L "$root$guest" ] || fail "nothing was published at $guest"
    "$C/mkdir" -p "$out"
    "$NIX_STORE" --dump "$root$guest" > "$archive" || fail "cannot archive $guest"

    # A recorded build names the digest its archive must have. An archive
    # with another digest is removed, so that no later step can use it.
    if [ -n "$expected" ]; then
        actual=$("$C/sha256sum" < "$archive")
        actual=${actual%% *}
        if [ "$actual" != "$expected" ]; then
            "$C/rm" -f "$archive"
            echo "$name$NOT_REPRODUCED" >&2
            echo "  the archive of $guest is sha256:$actual, recorded sha256:$expected" >&2
            exit 1
        fi
    fi
    exit 0
fi

# ---- start the processes ----------------------------------------------------

# The sandbox every process shares: the staged tree as the only writable
# state, the store closure at its own paths, nothing else.
sandbox=("$BWRAP" --unshare-all --die-with-parent --clearenv
    --uid "$BUILD_UID" --gid "$BUILD_GID" --hostname "$BUILD_HOST"
    --dev /dev --proc /proc
    --bind "$root/tmp" /tmp
    --bind "$root/nix/store" /nix/store
    --ro-bind "$root/bin" /bin --ro-bind "$root/etc" /etc)
while IFS= read -r store_path; do
    sandbox+=(--ro-bind "$store_path" "$store_path")
done < "$(find_input closure.txt)"
sandbox+=(--bind "$root/build" /build)

# A project's source tree comes from the inputs this step was given, never
# from the host's store, which holds the tree as it was when the build was
# recorded. The staged tree is mounted last, over whatever a store path
# above has at that place.
if source_file=$(find_optional_input source.txt); then
    source_root=$(< "$source_file")
    "$C/mkdir" -p "$root$source_root"
    sandbox+=(--ro-bind "$root$source_root" "$source_root")
fi

# Pipes between the processes. The script holds both ends of each one, the
# way the builder did, and gives each process the end it had.
declare -A pipe_r pipe_w
for id in "${!pipe_last_writer[@]}"; do
    # The shell has no call for pipe(2), and a named fifo will not do: a
    # process that opens /dev/fd/63, as one given a process substitution
    # does, would block until the fifo has a writer, which a pipe never
    # asks for. A process substitution of the script's own is a real pipe.
    # Opening that pipe for reading and writing through /proc yields both
    # ends, and each end is then opened on its own.
    both=$((next_descriptor++))
    reader=$((next_descriptor++))
    writer=$((next_descriptor++))
    eval "exec $both<> <(:)" || fail "cannot create a pipe"
    eval "exec $reader< /proc/self/fd/$both $writer> /proc/self/fd/$both" || fail "cannot open a pipe"
    eval "exec $both>&-"
    pipe_r[$id]=$reader
    pipe_w[$id]=$writer
done

# The script's own standard error, kept on a descriptor of its own. A
# process can be given a file as descriptor 2 and the script's standard
# error as descriptor 3, and by the time 3 is placed, 2 is already the
# file.
script_error=$((next_descriptor++))
eval "exec $script_error>&2"

# Files of bytes the builder had written into a pipe, by name. Each is
# opened once, so that the processes that shared the pipe share the
# file's offset and none of them reads what another already read.
declare -A feed

pids=()             # the pid of each process, by index
names=()            # its program's name, for messages
expected=()         # the exit status the recording saw
declare -A status   # exit status by pid, for every child that has been reaped
problems=()

# Waits for any one child and records how it ended.
reap() {
    local pid
    wait -n -p pid
    local code=$?
    [ -n "${pid:-}" ] && status[$pid]=$code
}

index=0
while [ $# -gt 0 ]; do
    [ "$1" = run ] || fail "expected run, found $1"
    shift
    cwd=/build
    env_file=
    argv0=
    fds=()
    after=
    want=0
    argc=0
    while [ "$1" != -- ]; do
        case $1 in
            --cwd) cwd=$2 ;;
            --env) env_file=$2 ;;
            --argv0) argv0=$2 ;;
            --fd) fds+=("$2") ;;
            --after) after=$2 ;;
            --status) want=$2 ;;
            --argc) argc=$2 ;;
            *) fail "unknown run option $1" ;;
        esac
        shift 2
    done
    shift
    argv=("${@:1:argc}")
    shift "$argc"

    # Keep the recorded order: a process starts once every process that had
    # exited before its execve has exited here.
    for other in ${after//,/ }; do
        while [ -z "${status[${pids[$other]}]:-}" ]; do
            reap
        done
    done

    command=("${sandbox[@]}")
    if [ -n "$env_file" ]; then
        while IFS= read -r -d '' variable; do
            command+=(--setenv "${variable%%=*}" "${variable#*=}")
        done < "$(find_input "env/$env_file.env")"
    fi
    command+=(--chdir "$cwd")
    [ -n "$argv0" ] && command+=(--argv0 "$argv0")
    command+=(-- "${argv[@]}")

    # Open the fed files this process is the first to use.
    for spec in "${fds[@]}"; do
        what=${spec#*=}
        if [[ $what == data:* ]] && [ -z "${feed[${what#data:}]:-}" ]; then
            feed[${what#data:}]=$((next_descriptor++))
            eval "exec ${feed[${what#data:}]}< \"\$(find_input \"\${what#data:}\")\"" || fail "cannot open ${what#data:}"
        fi
    done

    # A traced run puts the same sandbox under strace, which follows it
    # inside and exits with its status.
    if [ -n "${GENRULIFY_TRACE:-}" ]; then
        command=("$GENRULIFY_STRACE" -f -ff -y -qq -s 4096 -e trace=%file
            -o "$GENRULIFY_TRACE/$index" "${command[@]}")
    fi

    (
        # Place this process's descriptors.
        for spec in "${fds[@]}"; do
            fd=${spec%%=*}
            what=${spec#*=}
            case $what in
                null) eval "exec $fd<> /dev/null" ;;
                err) eval "exec $fd>&$script_error" ;;
                pipe-r:*) eval "exec $fd<&${pipe_r[${what#pipe-r:}]}" ;;
                pipe-w:*) eval "exec $fd>&${pipe_w[${what#pipe-w:}]}" ;;
                data:*) eval "exec $fd<&${feed[${what#data:}]}" ;;
                store:*) eval "exec $fd< \"\${what#store:}\"" ;;
                file:r:*) eval "exec $fd< \"\$root\${what#file:r:}\"" ;;
                file:r@*)
                    # head reads exactly the bytes asked for, which leaves
                    # the descriptor at the offset.
                    offset=${what#file:r@}
                    eval "exec $fd< \"\$root\${offset#*:}\"" &&
                        "$C/head" -c "${offset%%:*}" <&"$fd" > /dev/null
                    ;;
                file:w:*) eval "exec $fd> \"\$root\${what#file:w:}\"" ;;
                file:a:*) eval "exec $fd>> \"\$root\${what#file:a:}\"" ;;
                *) fail "unknown descriptor $spec" ;;
            esac || exit 126
        done

        # Drop every descriptor the script holds, so that a pipe is open
        # only in the processes the recording saw it open in.
        for held in "${pipe_r[@]}" "${pipe_w[@]}" "${feed[@]}" "$script_error"; do
            eval "exec $held>&-"
        done
        exec "${command[@]}"
    ) &
    pids[index]=$!
    names[index]=${argv0:-${argv[0]}}
    names[index]=${names[index]##*/}
    expected[index]=$want

    # Close the script's copy of a pipe's write end once every writer has
    # its own, so that readers see end of file when the writers exit.
    for id in "${!pipe_w[@]}"; do
        if [ "${pipe_last_writer[$id]}" = "$index" ]; then
            eval "exec ${pipe_w[$id]}>&-"
            unset "pipe_w[$id]"
        fi
    done
    index=$((index + 1))
done

# The builder kept reading a pipe after the processes that held its read
# end were gone, as a `while read` loop or a command substitution does.
# Nothing replays the builder, so once those processes have exited the
# leftover bytes are discarded and the writers can finish. If the recording
# saw a writer killed for writing on, the read end is closed instead.
for id in "${!pipe_r[@]}"; do
    (
        for held in "${pipe_w[@]}" "${feed[@]}"; do eval "exec $held>&-"; done

        # Hold the read end of this pipe alone. A helper that kept another
        # pipe's read end open would keep that pipe's writer from ever
        # being told that its reader is gone.
        for other in "${!pipe_r[@]}"; do
            if [ "$other" != "$id" ]; then
                eval "exec ${pipe_r[$other]}<&-"
            fi
        done
        for reader in ${pipe_readers[$id]//,/ }; do
            while kill -0 "${pids[$reader]}" 2> /dev/null; do
                "$C/sleep" 0.02
            done
        done
        if [ "${pipe_broke[$id]}" != 1 ]; then
            "$C/cat" <&"${pipe_r[$id]}" > /dev/null
        fi
    ) &
    eval "exec ${pipe_r[$id]}<&-"
done

# A process must end the way the recording saw it end.
for ((i = 0; i < index; i++)); do
    while [ -z "${status[${pids[$i]}]:-}" ]; do
        reap
    done
    actual=${status[${pids[$i]}]}
    if [ "$actual" != "${expected[$i]}" ]; then
        problems+=("${names[$i]} exited with $actual, recorded ${expected[$i]}")
    fi
done

# ---- check the results ------------------------------------------------------

describe() {
    # Prints "KIND MODE CONTENT" for a host path.
    local path=$1
    if [ -L "$path" ]; then
        printf 'link 0 %s' "$("$C/readlink" "$path")"
    elif [ -d "$path" ]; then
        printf 'dir %s ' "$("$C/stat" -c %a "$path")"
    else
        local digest
        digest=$("$C/sha256sum" < "$path")
        printf 'file %s %s' "$("$C/stat" -c %a "$path")" "${digest%% *}"
    fi
}

left=()             # what a trusted step saw each result to be

if [ ${#results[@]} -gt 0 ]; then
    while IFS=$FS read -r kind mode mtime path content artifact; do
        host=$root$path
        want="$kind $mode $content"

        # A process that picks a random name, as mktemp does, wrote the
        # recorded entry under another one. What later steps can observe of
        # a path is its kind, mode and content, so an entry in the same
        # directory that this step neither was given nor is expected to
        # write, and that matches all three, is the recorded entry. Later
        # steps were recorded using the old name and get it under that one.
        if [ -z "$trust" ] && [ ! -e "$host" ] && [ ! -L "$host" ]; then
            for candidate in "${host%/*}"/* "${host%/*}"/.[!.]*; do
                [ -e "$candidate" ] || [ -L "$candidate" ] || continue
                [ -z "${known[${candidate#"$root"}]:-}" ] || continue
                if [ "$(describe "$candidate")" = "$want" ]; then
                    known[${candidate#"$root"}]=1
                    host=$candidate
                    break
                fi
            done
        fi
        if [ ! -e "$host" ] && [ ! -L "$host" ]; then
            problems+=("missing $path")
            continue
        fi
        got=$(describe "$host")

        # A trusted result has to be the kind of thing that was recorded.
        # Its bytes are whatever the sources now give.
        if [ -n "$trust" ]; then
            if [ "${got%% *}" != "$kind" ]; then
                problems+=("differs $path: got a ${got%% *}, recorded a $kind")
                continue
            fi

            # The mode and the symlink target are for whoever is given the
            # entry. A file's digest is left out, so that a stamp changes
            # only when one of those does.
            seen=${got#* }
            target=
            if [ "$kind" = link ]; then
                target=${seen#* }
            fi
            left+=("$kind$FS${seen%% *}$FS$path$FS$target")
        elif [ "$got" != "$want" ]; then
            problems+=("differs $path: got $got, recorded $want")
            continue
        fi
        if [ -n "$artifact" ]; then
            "$C/mkdir" -p "$out/${artifact%/*}"
            "$C/cp" "$host" "$out/$artifact"
        fi
    done < <(printf '%s\n' "${results[@]}")
fi

# Every entry under an output path ends up in the package. One that the
# recorded command did not write has no rule to carry it there, so a
# trusted step that leaves one fails and does not drop the entry quietly.
if [ -n "$trust" ] && outputs_file=$(find_optional_input "$OUTPUTS_FILE"); then
    while IFS= read -r output; do
        while IFS= read -r -d '' entry; do
            # The pattern below also yields the output path itself with a
            # slash after it.
            entry=${entry%/}
            if [ -z "${known[${entry#"$root"}]:-}" ]; then
                problems+=("unrecorded ${entry#"$root"}")
            fi
        done < <(
            shopt -s globstar dotglob nullglob
            if [ -e "$root$output" ] || [ -L "$root$output" ]; then
                printf '%s\0' "$root$output" "$root$output"/**
            fi
        )
    done < "$outputs_file"
fi

if [ ${#problems[@]} -gt 0 ]; then
    if [ -z "$trust" ]; then
        echo "$name$NOT_REPRODUCED" >&2
    else
        echo "$name$NOT_LEFT" >&2
    fi
    printf '  %s\n' "${problems[@]}" >&2

    # In a project the usual cause is an edit that changed what a command
    # reads or writes: a new header, a new source file, a renamed output,
    # a directory that is no longer made. The rules were written from one
    # build and know nothing of it.
    if [ -n "$trust" ]; then
        echo "  If a command now reads or writes a file it did not when the build was recorded, convert the project again." >&2
    fi
    exit 1
fi

# Every rule writes a stamp, so a step whose results are all directories
# still has a file for the build system to track. Buck2 tracks the
# directory of the step's files instead, so that directory always exists.
# The stamp of a trusted step says what the step left.
"$C/mkdir" -p "$out/$name"
if [ ${#left[@]} -gt 0 ]; then
    printf '%s\n' "${left[@]}" > "$out/$name$STAMP"
else
    : > "$out/$name$STAMP"
fi
