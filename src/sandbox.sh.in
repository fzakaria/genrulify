#!@SPLICE_BASH@/bin/bash
# Runs one step of a recorded build the way the recording saw it run, and
# checks that it left what the recording saw it leave.
#
# A generated genrule calls this script with the step's real command line.
# The script exists because a recorded command only makes sense in the
# place it ran: it names /build and the output path absolutely, expects its
# recorded environment and descriptors, and must not see files the rule
# did not declare. So the script stages the declared inputs under a
# private root, mounts that root and the store closure at their recorded
# paths with bubblewrap, starts each process, and compares every declared
# result with the recorded kind, mode and SHA-256 before handing it on.
#
# usage: sandbox.sh --name NAME --in DIR... --out DIR [--timeout SECONDS] [--trust]
#                   [--pipe ID:LAST_WRITER:READERS:BROKE]...
#                   (run OPTIONS --argc N -- PROGRAM ARG...)...
#        sandbox.sh --name NAME --in DIR... --out DIR pack GUEST_PATH [SHA256]
#
# Files are looked up by name under each --in directory:
#   actions/NAME.manifest   the entries to stage and the results to expect
#   closure.txt             store paths to mount read-only
#   env/N.env               an environment, NUL-separated NAME=VALUE
#   source.txt              for a project, the store path of its source
#                           tree, which is staged and not read from the host
#   roots.txt               for a project, the directories the build can
#                           write: /build and the output paths
#   RULE.ok                 the stamp of a rule this step takes entries from
#
# With --trust a result is whatever the processes left, provided it is
# there and is a file, a directory or a symlink as recorded. The commands
# of a project that read its sources run that way, so that an edited source
# builds. Such a step writes into its stamp the mode of each file and
# directory it left and the target of each symlink, and a step that is
# given one of those entries stages it as the stamp says. A trusted step
# that leaves an entry the recorded build did not leave, anywhere the
# build can write, fails: no rule would pick the entry up, and no later
# step would be given the entry. So does one that leaves a path the
# recorded command removed, and one that changes or removes an entry the
# recorded command was given and left as it was: the rules after it were
# written for what the recorded command did to each path.
#
# A manifest line is a tag and then a kind, a mode, an mtime, a path, the
# content, an artifact and an origin. The tag `in` is an entry to stage,
# `out` a result to expect, `unused` a path the recorded command wrote
# that nothing reads, and `gone` a path the recorded command removed. The
# origin of an `in` line is empty when the entry is
# staged as recorded, the name of the rule whose stamp describes it, or
# @checkout for a file of the project, which keeps the executable bit the
# project's file has.
#
# run options:
#   --cwd DIR        working directory inside the sandbox
#   --env N          which environment file to use
#   --umask MASK     the file-creation mask, in octal, when it is not the
#                    one a Nix build starts with
#   --argv0 TEXT     argv[0], when it differs from PROGRAM
#   --fd N=SPEC      descriptor N: null, err, pipe-r:ID, pipe-w:ID,
#                    data:FILE (bytes the builder had written into a pipe),
#                    store:PATH, file:r|w|a:GUEST_PATH, or
#                    file:r@OFFSET:GUEST_PATH for a file already read up to
#                    an offset
#   --after I,J      start only after processes I and J have exited
#   --status N       the exit status the recording saw
set -u

C=@SPLICE_COREUTILS@/bin
BWRAP=@SPLICE_BWRAP@/bin/bwrap
NIX_STORE=@SPLICE_NIX@/bin/nix-store

# The identity the Nix sandbox gives a builder, which the recording had.
BUILD_UID=1000
BUILD_GID=100
BUILD_HOST=localhost

# The file-creation mask a Nix build starts its builder with. A process
# is given this mask unless the recording saw it have another, so that
# the mode of a file it creates does not depend on the mask of whoever
# runs the build system.
BUILD_UMASK=022

# The phrases a failure is reported with. `genrulify learn` reads them back
# out of a build log.
NOT_REPRODUCED=" did not reproduce the recording:"

# The same for a rule of a project, which is not held to the recorded
# bytes: its results are missing or are another kind of thing.
NOT_LEFT=" did not leave what the recorded build left:"

# The field separator of a manifest line. A tab would do, except that the
# shell merges adjacent tabs and so loses an empty field.
FS=$'\x1f'

# The extension of the stamp a step writes once its results check out, the
# origin of a file that is the project's own, and the file that lists the
# directories a project's build can write.
STAMP=.ok
CHECKOUT=@checkout
ROOTS_FILE=roots.txt

# Permission bits: the owner's right to execute, everyone's right to
# execute, and everyone's right to read. A read bit is two places above
# the execute bit of the same class.
OWNER_EXECUTE=$((8#100))
ALL_EXECUTE=$((8#111))
ALL_READ=$((8#444))
READ_TO_EXECUTE=2
OWNER_ALL=$((8#700))

fail() {
    echo "sandbox.sh: $*" >&2
    exit 2
}

# The script keeps pipe ends and fed files open on descriptors of its own
# until each process has the ones it needs. Those must not collide with a
# descriptor a process is to be given, such as the 63 of a process
# substitution, so they are numbered from above the highest one asked for.
FIRST_HELD_DESCRIPTOR=100
next_descriptor=$FIRST_HELD_DESCRIPTOR
previous=
for argument in "$@"; do
    number=${argument%%=*}
    if [ "$previous" = --fd ] && [[ $number =~ ^[0-9]+$ ]] && [ "$number" -ge "$next_descriptor" ]; then
        next_descriptor=$((number + 1))
    fi
    previous=$argument
done

# ---- arguments up to the first `run` or `pack` ------------------------------

name=
out=
timeout=
trust=
in_dirs=()
declare -A pipe_last_writer pipe_readers pipe_broke
while [ $# -gt 0 ]; do
    case $1 in
        --name) name=$2; shift 2 ;;
        --in) in_dirs+=("$2"); shift 2 ;;
        --out) out=$2; shift 2 ;;
        --timeout) timeout=$2; shift 2 ;;
        --trust) trust=1; shift ;;
        --pipe)
            IFS=: read -r id last readers broke <<< "$2"
            pipe_last_writer[$id]=$last
            pipe_readers[$id]=$readers
            pipe_broke[$id]=$broke
            shift 2
            ;;
        run | pack) break ;;
        *) fail "unknown option $1" ;;
    esac
done
[ -n "$name" ] && [ -n "$out" ] || fail "--name and --out are required"

# A process that waits for input the recording had and this run does not
# would wait forever. Run the whole step under a deadline.
if [ -n "$timeout" ] && [ -z "${GENRULIFY_DEADLINE:-}" ]; then
    saved=(--name "$name" --out "$out" ${trust:+--trust})
    for dir in "${in_dirs[@]}"; do saved+=(--in "$dir"); done
    for id in "${!pipe_last_writer[@]}"; do
        saved+=(--pipe "$id:${pipe_last_writer[$id]}:${pipe_readers[$id]}:${pipe_broke[$id]}")
    done
    GENRULIFY_DEADLINE=1 exec "$C/timeout" --kill-after=10 "$timeout" "$0" "${saved[@]}" "$@"
fi

# Finds a file among the --in directories without starting a process. Sets
# `found` to the file and `found_in` to the directory that holds it.
locate() {
    for found_in in "${in_dirs[@]}"; do
        found=$found_in/$1
        if [ -e "$found" ]; then
            return 0
        fi
    done
    return 1
}

# The first --in directory that holds a file.
find_input() {
    locate "$1" || fail "no input named $1"
    printf '%s' "$found"
}

# The same for a file a workspace need not have. Fails quietly.
find_optional_input() {
    locate "$1" || return 1
    printf '%s' "$found"
}

# Starting a process costs about a millisecond, and a step can be given
# thousands of files. So the script does not run a command per file where
# one command can take many: it collects paths and hands them over in
# batches. A batch is at most this many paths, which stays far below what
# the kernel allows on one command line.
BATCH=500

# Runs the command after $1 once for each batch of the paths in the array
# named $1, with the batch as its last arguments.
each_batch() {
    local -n batched_paths=$1
    shift
    local start
    for ((start = 0; start < ${#batched_paths[@]}; start += BATCH)); do
        "$@" "${batched_paths[@]:start:BATCH}" || return 1
    done
}

# The same for a list kept as text, one path on each line, which is how
# the lists of an associative array are kept.
each_batch_of_lines() {
    local lines=${1%$'\n'}
    shift
    local -a listed_paths=()
    if [ -n "$lines" ]; then
        mapfile -t listed_paths <<< "$lines"
    fi
    each_batch listed_paths "$@"
}

# Loads the stamp of the rule $1, once: what that rule saw each of its
# results to be. A rule held to the recording writes an empty stamp,
# because its results are the recorded ones.
declare -A stamp_loaded seen_mode seen_target
observe() {
    [ -z "${stamp_loaded[$1]:-}" ] || return 0
    stamp_loaded[$1]=1
    local stamp kind mode path target
    stamp=$(find_optional_input "$1$STAMP") || return 0
    while IFS=$FS read -r kind mode path target; do
        seen_mode[$1$FS$path]=$mode
        seen_target[$1$FS$path]=$target
    done < "$stamp"
}

# The recorded mode $1 with the executable bits of the project's file $2.
# Nix stores a file as executable or not, by the owner's bit, and a build
# that copies the file hands that on. Every class that may read the file
# may then run it.
checkout_mode() {
    local held
    held=$("$C/stat" -L -c %a "$2") || fail "cannot stat $2"
    with_checkout_bits "$1" "$held"
    printf '%s' "$staged_mode"
}

# The same from the mode $2 the project's file has, without starting a
# process. Sets `staged_mode`.
with_checkout_bits() {
    local recorded=$((8#$1))
    if (((8#$2 & OWNER_EXECUTE) != 0)); then
        printf -v staged_mode '%o' $((recorded | ((recorded & ALL_READ) >> READ_TO_EXECUTE)))
    else
        printf -v staged_mode '%o' $((recorded & ~ALL_EXECUTE))
    fi
}

links=()            # target and host path of every symlink to stage
scratch=$("$C/mktemp" -d) || fail "cannot create a scratch directory"
cleanup() {
    # Staged directories keep their recorded modes, which can deny the
    # owner the access removal needs.
    "$C/chmod" -R u+rwx "$scratch" 2> /dev/null
    "$C/rm" -rf "$scratch"
}
trap cleanup EXIT
root=$scratch/root
"$C/mkdir" -p "$root/build" "$root/nix/store" "$root/tmp" "$root/bin" "$root/etc"

# ---- stage the declared inputs ----------------------------------------------

# The outputs are copied from inside other directories, so the place they
# go to is made absolute.
case $out in
    /*) ;;
    *) out=$PWD/$out ;;
esac

manifest=$(find_input "actions/$name.manifest")
declare -A known        # guest paths the step was given or is expected to write
declare -A written      # guest paths the recorded command wrote
declare -A gone         # guest paths the recorded command removed
given=()                # guest paths a trusted step was given
declare -A given_from   # where the file at each of those was copied from
declare -A given_target # the target of the symlink at each of those
directories=()          # mode, mtime and path of every staged directory
results=()              # the manifest's `out` lines

# What staging collects to do in batches. A file whose artifact is named
# after its producer and then its guest path, as `s12_tar/build/a.c` is
# for /build/a.c, is copied by one cp for all such files of the producer,
# which recreates each path below the root. A file of the project that
# is staged under its own path below some directory, as `sub/a.c` is at
# /build/app/sub/a.c, is copied the same way with the others staged below
# that directory. Every other file is copied on its own.
declare -A tree_copies  # paths to copy, by where they are relative to and where they go
declare -A tree_of      # where a producer's files are, by producer
checkout_dir=           # where the project's files are
checkout_files=()       # recorded mode, path in the project and staged path of each
declare -A by_mode      # staged files, by the mode to give them
declare -A by_time      # staged files and directories, by mtime
declare -A links_by_time
declare -A parents      # the directories the copied files go into
made_directories=()

# Copies the files "$@", given relative to the directory $1, to the same
# places below the staging root.
copy_tree() {
    local from=${1%%"$FS"*} to=${1#*"$FS"}
    shift
    (cd "$from" && "$C/cp" --parents -t "$to" -- "$@")
}

while IFS=$FS read -r tag kind mode mtime path content artifact origin; do
    known[$path]=1
    if [ "$tag" = out ]; then
        written[$path]=1
        results+=("$kind$FS$mode$FS$mtime$FS$path$FS$content$FS$artifact")
        continue
    fi
    if [ "$tag" = unused ]; then
        written[$path]=1
        continue
    fi
    if [ "$tag" = gone ]; then
        gone[$path]=1
        continue
    fi
    host=$root$path
    if [ -n "$trust" ]; then
        given+=("$path")
    fi

    # An entry a trusted rule made is staged the way that rule left it.
    if [ -n "${origin:-}" ] && [ "$origin" != "$CHECKOUT" ]; then
        observe "$origin"
        if [ -n "${seen_mode[$origin$FS$path]:-}" ]; then
            mode=${seen_mode[$origin$FS$path]}
            if [ "$kind" = link ]; then
                content=${seen_target[$origin$FS$path]}
            fi
        fi
    fi
    case $kind in
        dir)
            made_directories+=("$host")
            directories+=("$mode$FS$mtime$FS$path")
            ;;
        link)
            made_directories+=("${host%/*}")
            links+=("$content$FS$host")
            given_target[$path]=$content
            links_by_time[$mtime]+=$host$'\n'
            ;;
        file)
            producer=${artifact%"$path"}
            if [ -n "$producer" ] && [ "$producer" != "$artifact" ] && [ "${origin:-}" != "$CHECKOUT" ]; then
                # Every file of one producer is in the same place, so the
                # first one says where.
                if [ -z "${tree_of[$producer]:-}" ]; then
                    locate "$artifact" || fail "no input named $artifact"
                    tree_of[$producer]=$found_in/$producer
                fi
                tree_copies[${tree_of[$producer]}$FS$root]+=${path#/}$'\n'
                given_from[$path]=${tree_of[$producer]}$path
                by_mode[$mode]+=$host$'\n'
                parents[${host%/*}]=1
            elif [ "${origin:-}" = "$CHECKOUT" ] && [[ $path == */"$artifact" ]]; then
                # The project's files are all in one place too. Their modes
                # are decided below, once the project's own are known.
                if [ -z "$checkout_dir" ]; then
                    locate "$artifact" || fail "no input named $artifact"
                    checkout_dir=$found_in
                fi
                tree_copies[$checkout_dir$FS$root${path%/"$artifact"}]+=$artifact$'\n'
                checkout_files+=("$mode$FS$artifact$FS$host")
                given_from[$path]=$checkout_dir/$artifact
                parents[${host%/*}]=1
            else
                locate "$artifact" || fail "no input named $artifact"
                if [ "${origin:-}" = "$CHECKOUT" ]; then
                    mode=$(checkout_mode "$mode" "$found")
                fi
                "$C/install" -D -m "$mode" "$found" "$host" || fail "cannot stage $path"
                given_from[$path]=$found
            fi
            by_time[$mtime]+=$host$'\n'
            ;;
        *) fail "unknown entry kind $kind" ;;
    esac
done < "$manifest"

# Directories first, then the files of each producer, then the symlinks.
# The directory a file goes into is made here and not left to cp, which
# would give a directory it creates the mode of the one it copies from.
made_directories+=("${!parents[@]}")
each_batch made_directories "$C/mkdir" -p -- || fail "cannot create the staged directories"
for tree in "${!tree_copies[@]}"; do
    each_batch_of_lines "${tree_copies[$tree]}" copy_tree "$tree" || fail "cannot stage the files of ${tree%%"$FS"*}"
done

# A file of the project gets its recorded mode with the executable bits
# the project's file has now, which one stat reads for all of them.
if [ ${#checkout_files[@]} -gt 0 ]; then
    declare -A held
    asked=()
    for item in "${checkout_files[@]}"; do
        item=${item#*"$FS"}
        asked+=("${item%%"$FS"*}")
    done
    while IFS=$FS read -r -d '' bits file; do
        held[$file]=$bits
    done < <(cd "$checkout_dir" && each_batch asked "$C/stat" -L --printf "%a$FS%n\0" --)
    while IFS=$FS read -r mode file host; do
        [ -n "${held[$file]:-}" ] || fail "cannot stat $file"
        with_checkout_bits "$mode" "${held[$file]}"
        by_mode[$staged_mode]+=$host$'\n'
    done < <(printf '%s\n' "${checkout_files[@]}")
fi
if [ ${#links[@]} -gt 0 ]; then
    while IFS=$FS read -r target host; do
        "$C/ln" -s "$target" "$host" || fail "cannot stage ${host#"$root"}"
    done < <(printf '%s\n' "${links[@]}")
fi

# The recorded modes and mtimes, one command for all the files that share
# a value.
for mode in "${!by_mode[@]}"; do
    each_batch_of_lines "${by_mode[$mode]}" "$C/chmod" "$mode" -- || fail "cannot set modes"
done
for mtime in "${!by_time[@]}"; do
    each_batch_of_lines "${by_time[$mtime]}" "$C/touch" -d "@$mtime" -- || fail "cannot set mtimes"
done
for mtime in "${!links_by_time[@]}"; do
    each_batch_of_lines "${links_by_time[$mtime]}" "$C/touch" -h -d "@$mtime" -- || fail "cannot set mtimes"
done

# A directory gets its recorded mode and mtime last: the mode can deny the
# writes that created its children, and those writes move its mtime. The
# deepest directories come first, so that a mode which shuts a directory
# is set after everything below it is done.
if [ ${#directories[@]} -gt 0 ]; then
    declare -A directories_by_time directories_by_mode
    ordered=()
    while IFS=$FS read -r mode mtime path; do
        directories_by_time[$mtime]+=$root$path$'\n'
        ordered+=("$mode$FS$root$path")
    done < <(printf '%s\n' "${directories[@]}" | "$C/sort" -t"$FS" -k3,3r)
    for mtime in "${!directories_by_time[@]}"; do
        each_batch_of_lines "${directories_by_time[$mtime]}" "$C/touch" -d "@$mtime" -- || fail "cannot set mtimes"
    done

    # A mode that leaves the owner every right shuts nothing, so all the
    # directories with it can be changed at once. Any other mode is set
    # one directory at a time, in order.
    shutting=()
    for item in "${ordered[@]}"; do
        mode=${item%%"$FS"*}
        if (((8#$mode & OWNER_ALL) == OWNER_ALL)); then
            directories_by_mode[$mode]+=${item#*"$FS"}$'\n'
        else
            shutting+=("$item")
        fi
    done
    for mode in "${!directories_by_mode[@]}"; do
        each_batch_of_lines "${directories_by_mode[$mode]}" "$C/chmod" "$mode" -- || fail "cannot set modes"
    done
    for item in "${shutting[@]}"; do
        "$C/chmod" "${item%%"$FS"*}" "${item#*"$FS"}" || fail "cannot set modes"
    done
fi

# ---- what a trusted step has to leave as it is ------------------------------

# The directories a project's build can write, which are all a trusted
# step is asked about.
writable_roots=()
if [ -n "$trust" ] && roots_file=$(find_optional_input "$ROOTS_FILE"); then
    while IFS= read -r writable; do
        writable_roots+=("$writable")
    done < "$roots_file"
fi

# The entries the step was given that the recorded command neither wrote
# nor removed, by host path. The graph has no later version of such a
# path, so every later step is given the entry as it is now.
alone=()
for path in "${given[@]}"; do
    if [ -n "${written[$path]:-}" ] || [ -n "${gone[$path]:-}" ]; then
        continue
    fi
    for writable in "${writable_roots[@]}"; do
        if [ "$path" = "$writable" ] || [[ $path == "$writable"/* ]]; then
            alone+=("$root$path")
            break
        fi
    done
done

# Prints what tells whether each entry "$@" was touched: its type and
# mode first, then its size, its modification time, its change time and
# its inode. An entry that is not there prints nothing.
marks() {
    "$C/stat" --printf "%f %s %Y %.9Z %i$FS%n\0" -- "$@" 2> /dev/null
}

# Fills the array named $1 with the marks of the entries left alone.
mark_alone() {
    local -n into=$1
    local seen file
    while IFS=$FS read -r -d '' seen file; do
        into[$file]=$seen
    done < <(each_batch alone marks)
}
declare -A marked_before
if [ ${#alone[@]} -gt 0 ]; then
    mark_alone marked_before
fi

# ---- pack: serialize one output path as a NAR -------------------------------

if [ "${1:-}" = pack ]; then
    guest=$2
    expected=${3:-}
    archive=$out/$name.nar
    [ -e "$root$guest" ] || [ -L "$root$guest" ] || fail "nothing was published at $guest"
    "$C/mkdir" -p "$out"
    "$NIX_STORE" --dump "$root$guest" > "$archive" || fail "cannot archive $guest"

    # A recorded build names the digest its archive must have. An archive
    # with another digest is removed, so that no later step can use it.
    if [ -n "$expected" ]; then
        actual=$("$C/sha256sum" < "$archive")
        actual=${actual%% *}
        if [ "$actual" != "$expected" ]; then
            "$C/rm" -f "$archive"
            echo "$name$NOT_REPRODUCED" >&2
            echo "  the archive of $guest is sha256:$actual, recorded sha256:$expected" >&2
            exit 1
        fi
    fi
    exit 0
fi

# ---- start the processes ----------------------------------------------------

# The sandbox every process shares: the staged tree as the only writable
# state, the store closure at its own paths, nothing else.
sandbox=("$BWRAP" --unshare-all --die-with-parent --clearenv
    --uid "$BUILD_UID" --gid "$BUILD_GID" --hostname "$BUILD_HOST"
    --dev /dev --proc /proc
    --bind "$root/tmp" /tmp
    --bind "$root/nix/store" /nix/store
    --ro-bind "$root/bin" /bin --ro-bind "$root/etc" /etc)
while IFS= read -r store_path; do
    sandbox+=(--ro-bind "$store_path" "$store_path")
done < "$(find_input closure.txt)"
sandbox+=(--bind "$root/build" /build)

# A project's source tree comes from the inputs this step was given, never
# from the host's store, which holds the tree as it was when the build was
# recorded. The staged tree is mounted last, over whatever a store path
# above has at that place.
if source_file=$(find_optional_input source.txt); then
    source_root=$(< "$source_file")
    "$C/mkdir" -p "$root$source_root"
    sandbox+=(--ro-bind "$root$source_root" "$source_root")
fi

# Pipes between the processes. The script holds both ends of each one, the
# way the builder did, and gives each process the end it had.
declare -A pipe_r pipe_w
for id in "${!pipe_last_writer[@]}"; do
    # The shell has no call for pipe(2), and a named fifo will not do: a
    # process that opens /dev/fd/63, as one given a process substitution
    # does, would block until the fifo has a writer, which a pipe never
    # asks for. A process substitution of the script's own is a real pipe.
    # Opening that pipe for reading and writing through /proc yields both
    # ends, and each end is then opened on its own.
    both=$((next_descriptor++))
    reader=$((next_descriptor++))
    writer=$((next_descriptor++))
    eval "exec $both<> <(:)" || fail "cannot create a pipe"
    eval "exec $reader< /proc/self/fd/$both $writer> /proc/self/fd/$both" || fail "cannot open a pipe"
    eval "exec $both>&-"
    pipe_r[$id]=$reader
    pipe_w[$id]=$writer
done

# The script's own standard error, kept on a descriptor of its own. A
# process can be given a file as descriptor 2 and the script's standard
# error as descriptor 3, and by the time 3 is placed, 2 is already the
# file.
script_error=$((next_descriptor++))
eval "exec $script_error>&2"

# Files of bytes the builder had written into a pipe, by name. Each is
# opened once, so that the processes that shared the pipe share the
# file's offset and none of them reads what another already read.
declare -A feed

pids=()             # the pid of each process, by index
names=()            # its program's name, for messages
expected=()         # the exit status the recording saw
declare -A status   # exit status by pid, for every child that has been reaped
problems=()

# Waits for any one child and records how it ended.
reap() {
    local pid
    wait -n -p pid
    local code=$?
    [ -n "${pid:-}" ] && status[$pid]=$code
}

index=0
while [ $# -gt 0 ]; do
    [ "$1" = run ] || fail "expected run, found $1"
    shift
    cwd=/build
    env_file=
    mask=$BUILD_UMASK
    argv0=
    fds=()
    after=
    want=0
    argc=0
    while [ "$1" != -- ]; do
        case $1 in
            --cwd) cwd=$2 ;;
            --env) env_file=$2 ;;
            --umask) mask=$2 ;;
            --argv0) argv0=$2 ;;
            --fd)
                fds+=("$2")

                # The file behind a descriptor is the recording's wiring:
                # the script opens the file, and the command did not
                # choose to make it. So the file counts as known even
                # when the recording has no entry for it, as for a named
                # pipe, which is opened here as a plain file.
                what=${2#*=}
                case $what in
                    file:r@*)
                        what=${what#file:r@}
                        known[${what#*:}]=1
                        ;;
                    file:[rwa]:*) known[${what#file:?:}]=1 ;;
                esac
                ;;
            --after) after=$2 ;;
            --status) want=$2 ;;
            --argc) argc=$2 ;;
            *) fail "unknown run option $1" ;;
        esac
        shift 2
    done
    shift
    argv=("${@:1:argc}")
    shift "$argc"

    # Keep the recorded order: a process starts once every process that had
    # exited before its execve has exited here.
    for other in ${after//,/ }; do
        while [ -z "${status[${pids[$other]}]:-}" ]; do
            reap
        done
    done

    command=("${sandbox[@]}")
    if [ -n "$env_file" ]; then
        while IFS= read -r -d '' variable; do
            command+=(--setenv "${variable%%=*}" "${variable#*=}")
        done < "$(find_input "env/$env_file.env")"
    fi
    command+=(--chdir "$cwd")
    [ -n "$argv0" ] && command+=(--argv0 "$argv0")
    command+=(-- "${argv[@]}")

    # Open the fed files this process is the first to use.
    for spec in "${fds[@]}"; do
        what=${spec#*=}
        if [[ $what == data:* ]] && [ -z "${feed[${what#data:}]:-}" ]; then
            feed[${what#data:}]=$((next_descriptor++))
            eval "exec ${feed[${what#data:}]}< \"\$(find_input \"\${what#data:}\")\"" || fail "cannot open ${what#data:}"
        fi
    done

    # A traced run puts the same sandbox under strace, which follows it
    # inside and exits with its status.
    if [ -n "${GENRULIFY_TRACE:-}" ]; then
        command=("$GENRULIFY_STRACE" -f -ff -y -qq -s 4096 -e trace=%file
            -o "$GENRULIFY_TRACE/$index" "${command[@]}")
    fi

    (
        # The mask comes first: a descriptor placed below can create its
        # file, as the builder's redirection did under the same mask.
        umask "$mask"

        # Place this process's descriptors.
        for spec in "${fds[@]}"; do
            fd=${spec%%=*}
            what=${spec#*=}
            case $what in
                null) eval "exec $fd<> /dev/null" ;;
                err) eval "exec $fd>&$script_error" ;;
                pipe-r:*) eval "exec $fd<&${pipe_r[${what#pipe-r:}]}" ;;
                pipe-w:*) eval "exec $fd>&${pipe_w[${what#pipe-w:}]}" ;;
                data:*) eval "exec $fd<&${feed[${what#data:}]}" ;;
                store:*) eval "exec $fd< \"\${what#store:}\"" ;;
                file:r:*) eval "exec $fd< \"\$root\${what#file:r:}\"" ;;
                file:r@*)
                    # head reads exactly the bytes asked for, which leaves
                    # the descriptor at the offset.
                    offset=${what#file:r@}
                    eval "exec $fd< \"\$root\${offset#*:}\"" &&
                        "$C/head" -c "${offset%%:*}" <&"$fd" > /dev/null
                    ;;
                file:w:*) eval "exec $fd> \"\$root\${what#file:w:}\"" ;;
                file:a:*) eval "exec $fd>> \"\$root\${what#file:a:}\"" ;;
                *) fail "unknown descriptor $spec" ;;
            esac || exit 126
        done

        # Drop every descriptor the script holds, so that a pipe is open
        # only in the processes the recording saw it open in.
        for held in "${pipe_r[@]}" "${pipe_w[@]}" "${feed[@]}" "$script_error"; do
            eval "exec $held>&-"
        done
        exec "${command[@]}"
    ) &
    pids[index]=$!
    names[index]=${argv0:-${argv[0]}}
    names[index]=${names[index]##*/}
    expected[index]=$want

    # Close the script's copy of a pipe's write end once every writer has
    # its own, so that readers see end of file when the writers exit.
    for id in "${!pipe_w[@]}"; do
        if [ "${pipe_last_writer[$id]}" = "$index" ]; then
            eval "exec ${pipe_w[$id]}>&-"
            unset "pipe_w[$id]"
        fi
    done
    index=$((index + 1))
done

# The builder kept reading a pipe after the processes that held its read
# end were gone, as a `while read` loop or a command substitution does.
# Nothing replays the builder, so once those processes have exited the
# leftover bytes are discarded and the writers can finish. If the recording
# saw a writer killed for writing on, the read end is closed instead.
for id in "${!pipe_r[@]}"; do
    (
        for held in "${pipe_w[@]}" "${feed[@]}"; do eval "exec $held>&-"; done

        # Hold the read end of this pipe alone. A helper that kept another
        # pipe's read end open would keep that pipe's writer from ever
        # being told that its reader is gone.
        for other in "${!pipe_r[@]}"; do
            if [ "$other" != "$id" ]; then
                eval "exec ${pipe_r[$other]}<&-"
            fi
        done
        for reader in ${pipe_readers[$id]//,/ }; do
            while kill -0 "${pids[$reader]}" 2> /dev/null; do
                "$C/sleep" 0.02
            done
        done
        if [ "${pipe_broke[$id]}" != 1 ]; then
            "$C/cat" <&"${pipe_r[$id]}" > /dev/null
        fi
    ) &
    eval "exec ${pipe_r[$id]}<&-"
done

# A process must end the way the recording saw it end.
for ((i = 0; i < index; i++)); do
    while [ -z "${status[${pids[$i]}]:-}" ]; do
        reap
    done
    actual=${status[${pids[$i]}]}
    if [ "$actual" != "${expected[$i]}" ]; then
        problems+=("${names[$i]} exited with $actual, recorded ${expected[$i]}")
    fi
done

# ---- check the results ------------------------------------------------------

describe() {
    # Prints "KIND MODE CONTENT" for a host path.
    local path=$1
    if [ -L "$path" ]; then
        printf 'link 0 %s' "$("$C/readlink" "$path")"
    elif [ -d "$path" ]; then
        printf 'dir %s ' "$("$C/stat" -c %a "$path")"
    else
        local digest
        digest=$("$C/sha256sum" < "$path")
        printf 'file %s %s' "$("$C/stat" -c %a "$path")" "${digest%% *}"
    fi
}

# What every result that is there is now, as `describe` would print it,
# by host path. A step can leave thousands of results, so each question is
# put once for all of them: what kind of thing each is and its mode, the
# digest of each file, and the target of each symlink. A trusted step is
# not asked for digests, which nothing would compare.
declare -A described
describe_results() {
    local kind mode mtime path content artifact type line index
    local -a present=() files=() symlinks=() targets=()
    local -A kinds=() modes=() digests=()
    while IFS=$FS read -r kind mode mtime path content artifact; do
        if [ -e "$root$path" ] || [ -L "$root$path" ]; then
            present+=("$root$path")
        fi
    done < <(printf '%s\n' "${results[@]}")
    if [ ${#present[@]} -eq 0 ]; then
        return 0
    fi

    # stat does not follow a symlink, and ends each answer with a NUL.
    while IFS=$FS read -r -d '' type mode path; do
        case $type in
            'symbolic link') kinds[$path]=link; symlinks+=("$path") ;;
            directory) kinds[$path]=dir; modes[$path]=$mode ;;
            *) kinds[$path]=file; modes[$path]=$mode; files+=("$path") ;;
        esac
    done < <(each_batch present "$C/stat" --printf "%F$FS%a$FS%n\0" --)

    # With --zero, sha256sum prints a name as it is: digest, two spaces,
    # name.
    if [ -z "$trust" ] && [ ${#files[@]} -gt 0 ]; then
        while IFS= read -r -d '' line; do
            digests[${line#*  }]=${line%% *}
        done < <(each_batch files "$C/sha256sum" --zero --)
    fi

    # readlink answers in the order it was asked.
    if [ ${#symlinks[@]} -gt 0 ]; then
        mapfile -d '' -t targets < <(each_batch symlinks "$C/readlink" --zero --)
    fi
    for index in "${!symlinks[@]}"; do
        described[${symlinks[index]}]="link 0 ${targets[index]:-}"
    done
    for path in "${present[@]}"; do
        case ${kinds[$path]:-} in
            dir) described[$path]="dir ${modes[$path]} " ;;
            file) described[$path]="file ${modes[$path]} ${digests[$path]:-}" ;;
        esac
    done
}

left=()             # what a trusted step saw each result to be
kept=()             # the results to hand on, relative to the staging root
declare -A kept_parents # the directories those results go into

if [ ${#results[@]} -gt 0 ]; then
    describe_results
    while IFS=$FS read -r kind mode mtime path content artifact; do
        host=$root$path
        want="$kind $mode $content"

        # A process that picks a random name, as mktemp does, wrote the
        # recorded entry under another one. What later steps can observe of
        # a path is its kind, mode and content, so an entry in the same
        # directory that this step neither was given nor is expected to
        # write, and that matches all three, is the recorded entry. Later
        # steps were recorded using the old name and get it under that one.
        if [ -z "$trust" ] && [ ! -e "$host" ] && [ ! -L "$host" ]; then
            for candidate in "${host%/*}"/* "${host%/*}"/.[!.]*; do
                [ -e "$candidate" ] || [ -L "$candidate" ] || continue
                [ -z "${known[${candidate#"$root"}]:-}" ] || continue
                if [ "$(describe "$candidate")" = "$want" ]; then
                    known[${candidate#"$root"}]=1
                    host=$candidate
                    break
                fi
            done
        fi
        if [ ! -e "$host" ] && [ ! -L "$host" ]; then
            problems+=("missing $path")
            continue
        fi
        got=${described[$host]:-}
        if [ -z "$got" ]; then
            got=$(describe "$host")
        fi

        # A trusted result has to be the kind of thing that was recorded.
        # Its bytes are whatever the sources now give.
        if [ -n "$trust" ]; then
            if [ "${got%% *}" != "$kind" ]; then
                problems+=("differs $path: got a ${got%% *}, recorded a $kind")
                continue
            fi

            # The mode and the symlink target are for whoever is given the
            # entry. A file's digest is left out, so that a stamp changes
            # only when one of those does.
            seen=${got#* }
            target=
            if [ "$kind" = link ]; then
                target=${seen#* }
            fi
            left+=("$kind$FS${seen%% *}$FS$path$FS$target")
        elif [ "$got" != "$want" ]; then
            problems+=("differs $path: got $got, recorded $want")
            continue
        fi
        # A result is handed on under the step's name and then its guest
        # path, and all such results are copied out together below. One
        # found under another name, or whose artifact is named some other
        # way, is copied on its own.
        if [ -z "$artifact" ]; then
            continue
        fi
        if [ "$artifact" = "$name$path" ] && [ "$host" = "$root$path" ]; then
            kept+=("${path#/}")
            kept_parents[$out/${artifact%/*}]=1
            continue
        fi
        "$C/mkdir" -p "$out/${artifact%/*}"
        "$C/cp" "$host" "$out/$artifact"
    done < <(printf '%s\n' "${results[@]}")
fi

# A trusted step runs on sources that may have been edited, and can leave
# an entry the recorded command did not write. Under an output path the
# entry belongs in the package, and no rule would carry it there. Under
# /build a later command may open the entry or ask whether it is there,
# and that command's step is given only what the recording saw it use.
# So a trusted step that leaves such an entry anywhere the build can
# write fails, and does not drop the entry quietly.
if [ ${#writable_roots[@]} -gt 0 ]; then
    for writable in "${writable_roots[@]}"; do
        while IFS= read -r -d '' entry; do
            # The pattern below also yields the directory itself with a
            # slash after it.
            entry=${entry%/}
            if [ -z "${known[${entry#"$root"}]:-}" ]; then
                problems+=("unrecorded ${entry#"$root"}")
            fi
        done < <(
            shopt -s globstar dotglob nullglob
            if [ -e "$root$writable" ] || [ -L "$root$writable" ]; then
                printf '%s\0' "$root$writable" "$root$writable"/**
            fi
        )
    done
fi

# A path the recorded command removed has no later version in the graph,
# and an entry the recorded command left alone has only the version this
# step was given. Whatever the command did to either now, no later step
# would see it: a file that is no longer removed would be missing from
# the package, and a file that is now rewritten would be packed as it was
# before. So both fail the step.
for path in "${!gone[@]}"; do
    if [ -e "$root$path" ] || [ -L "$root$path" ]; then
        problems+=("kept $path, which the recorded command removed")
    fi
done
if [ ${#alone[@]} -gt 0 ]; then
    declare -A marked_after
    mark_alone marked_after
    for host in "${alone[@]}"; do
        was=${marked_before[$host]:-}
        is=${marked_after[$host]:-}
        if [ "$was" = "$is" ]; then
            continue
        fi
        path=${host#"$root"}
        if [ -z "$is" ]; then
            problems+=("removed $path, which the recorded command left alone")
            continue
        fi

        # Another type or mode is a change whatever else is the same. A
        # directory is touched by every entry made or removed inside it,
        # which is no change to the directory itself.
        if [ "${was%% *}" != "${is%% *}" ]; then
            problems+=("changed $path, which the recorded command left alone")
            continue
        fi
        if [ -d "$host" ] && [ ! -L "$host" ]; then
            continue
        fi

        # A file that was touched is compared with what was staged, so
        # that setting its time or linking to it is no change.
        if [ -L "$host" ]; then
            [ "$("$C/readlink" "$host")" = "${given_target[$path]:-}" ] ||
                problems+=("changed $path, which the recorded command left alone")
            continue
        fi
        [ "$("$C/sha256sum" < "${given_from[$path]:-}")" = "$("$C/sha256sum" < "$host")" ] ||
            problems+=("changed $path, which the recorded command left alone")
    done
fi

if [ ${#problems[@]} -gt 0 ]; then
    if [ -z "$trust" ]; then
        echo "$name$NOT_REPRODUCED" >&2
    else
        echo "$name$NOT_LEFT" >&2
    fi
    printf '  %s\n' "${problems[@]}" >&2

    # In a project the usual cause is an edit that changed what a command
    # reads or writes: a new header, a new source file, a renamed output,
    # a directory that is no longer made. The rules were written from one
    # build and know nothing of it.
    if [ -n "$trust" ]; then
        echo "  If a command now reads or writes a file it did not when the build was recorded, convert the project again." >&2
    fi
    exit 1
fi

# Copies the results "$@", given relative to the staging root, to the same
# places below the step's own directory.
hand_on() {
    (cd "$root" && "$C/cp" --parents -t "$out/$name" -- "$@")
}
if [ ${#kept[@]} -gt 0 ]; then
    # The directories are made first, so that none takes the mode of the
    # staged directory it mirrors, which the build system may not be able
    # to clean up.
    kept_directories=("${!kept_parents[@]}")
    each_batch kept_directories "$C/mkdir" -p -- || fail "cannot hand on the results"
    each_batch kept hand_on || fail "cannot hand on the results"
fi

# Every rule writes a stamp, so a step whose results are all directories
# still has a file for the build system to track. The stamp of a trusted
# step says what the step left.
"$C/mkdir" -p "$out"
if [ ${#left[@]} -gt 0 ]; then
    printf '%s\n' "${left[@]}" > "$out/$name$STAMP"
else
    : > "$out/$name$STAMP"
fi
